# Copy to .env.local and configure your own model endpoint. Never commit credentials.
SPKG_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Must equal an id returned by GET /v1/models (vllm --served-model-name).
SPKG_VLLM_MODEL=your-served-model-id
# No auth: false + blank key. Auth enabled: true + the actual vLLM key.
SPKG_VLLM_AUTH_REQUIRED=false
SPKG_VLLM_API_KEY=
SPKG_VLLM_TIMEOUT_SECONDS=300
SPKG_VLLM_MAX_WORKERS=2
# prompt: no response_format; json_object: server structured output required.
SPKG_VLLM_JSON_MODE=prompt
# Leave empty unless the exact model chat template supports the given switch.
# DeepSeek-V3.1 example: {"thinking":false}; some templates: {"enable_thinking":false}.
SPKG_VLLM_CHAT_TEMPLATE_KWARGS=
